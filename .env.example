# Copy to .env.local for local dev. Never commit real values.

# Data: production reads prebuilt tables from the serving bucket.
# Leave SERVING_BUCKET empty locally to build from raw files in mf-data-public.
SERVING_BUCKET=
DATA_BUCKET=mf-data-public
DATA_PREFIX=backend_main_kartik

# Users: set FIRESTORE_PROJECT to use Firestore; leave empty for an in-memory store (resets on restart).
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
SESSION_SECRET=            # 32+ random characters; required in production
DEV_DEFAULT_PLAN=free      # local in-memory store only: "pro" to test paid features

# Razorpay Subscriptions (use Test-mode values first; never expose secrets in NEXT_PUBLIC_*).
# The plan must be INR 400.00, monthly, interval 1. Billing requires Firestore.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# LLM
PARSER=gemini              # gemini | ollama | off
GOOGLE_CLOUD_PROJECT=gochanakya-main
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
